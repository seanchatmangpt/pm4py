<urn:pm4py-mcp:tool:discover_powl> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:pm4py-mcp:McpTool> .
<urn:pm4py-mcp:tool:discover_powl> <urn:pm4py-mcp:toolName> "discover_powl" .
<urn:pm4py-mcp:tool:discover_powl> <urn:pm4py-mcp:toolDescription> "Discover a Partially Ordered Workflow Language (POWL) model from an event log. POWL handles partial orders, loops, exclusive choices, and agent tasks." .
<urn:pm4py-mcp:tool:discover_powl> <urn:pm4py-mcp:pythonModule> "pm4py.algo.discovery.powl.algorithm" .
<urn:pm4py-mcp:tool:discover_powl> <urn:pm4py-mcp:pythonFunction> "apply" .
<urn:pm4py-mcp:tool:discover_powl> <urn:pm4py-mcp:hasArg> _:dp_arg1 .
_:dp_arg1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:pm4py-mcp:McpToolArg> .
_:dp_arg1 <urn:pm4py-mcp:argName> "file_path" .
_:dp_arg1 <urn:pm4py-mcp:argType> "string" .
_:dp_arg1 <urn:pm4py-mcp:argDescription> "Path to XES event log file or CSV dataframe" .
_:dp_arg1 <urn:pm4py-mcp:required> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<urn:pm4py-mcp:tool:discover_powl> <urn:pm4py-mcp:hasArg> _:dp_arg2 .
_:dp_arg2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:pm4py-mcp:McpToolArg> .
_:dp_arg2 <urn:pm4py-mcp:argName> "variant" .
_:dp_arg2 <urn:pm4py-mcp:argType> "enum:inductive,maximal,tree,brute_force,dynamic_clustering" .
_:dp_arg2 <urn:pm4py-mcp:argDescription> "Discovery algorithm variant. maximal recommended for most cases." .
_:dp_arg2 <urn:pm4py-mcp:required> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
_:dp_arg2 <urn:pm4py-mcp:defaultValue> "maximal" .

