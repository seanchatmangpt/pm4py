<urn:pm4py-mcp:tool:generate_powl_from_text> <urn:pm4py-mcp:hasArg> _:gp_arg1 .
_:gp_arg1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:pm4py-mcp:McpToolArg> .
