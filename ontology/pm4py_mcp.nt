_:gp_arg1 <urn:pm4py-mcp:argType> "string" .
_:gp_arg1 <urn:pm4py-mcp:argDescription> "Natural language description of the business process" .
_:gp_arg1 <urn:pm4py-mcp:required> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<urn:pm4py-mcp:tool:generate_powl_from_text> <urn:pm4py-mcp:hasArg> _:gp_arg2 .
_:gp_arg2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:pm4py-mcp:McpToolArg> .
