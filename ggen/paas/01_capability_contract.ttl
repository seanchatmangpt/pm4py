@prefix paas: <https://ggen.dev/paas#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

paas:PM4PyCapability a paas:Capability ;
  dct:title "PM4Py process-analysis capability" ;
  dct:description "Declares PM4Py as an analysis capability consumed through a governed adapter; process-intelligence algorithms remain outside this repository's GGen control plane." ;
  prov:wasDerivedFrom <https://github.com/process-intelligence-solutions/pm4py> .
